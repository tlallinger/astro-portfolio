---
/**
 * Cycles through the color themes defined in src/styles/theme.ts.
 * The chosen theme is stored in localStorage and applied before first paint by Layout.astro.
 */
import { Icon } from 'astro-icon/components';
import { t } from '@/i18n/utils';
import { themeNames } from '@/styles/theme';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'theme-switch group inline-flex size-10 items-center justify-center rounded-md text-skin-hue transition hover:bg-skin-button-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue',
    className,
  ]}
  data-themes={themeNames.join(',')}
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
>
  <Icon
    name="ri:palette-fill"
    class="transition-transform duration-300 group-hover:rotate-12"
    width={22}
    height={22}
    aria-hidden="true"
  />
</button>

<script>
  // The component may be used more than once per page (e.g. fixed corner + hero row).
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-switch');
  const root = document.documentElement;
  const names = buttons[0]?.dataset.themes?.split(',') ?? [];

  const applyTheme = (name: string) => {
    root.dataset.theme = name;
    try {
      localStorage.setItem('theme', name);
    } catch {
      // storage may be unavailable (private mode); the switch still works for this page view
    }
  };

  const nextTheme = () => {
    const index = names.indexOf(root.dataset.theme ?? '');
    return names[(index + 1) % names.length];
  };

  buttons.forEach((button) =>
    button.addEventListener('click', (event: MouseEvent) => {
      const name = nextTheme();
      if (!name) return;

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      if (reduceMotion || typeof document.startViewTransition !== 'function') {
        applyTheme(name);
        return;
      }

      // Reveal the new theme in a circle growing from the click position.
      const x = event.clientX || window.innerWidth / 2;
      const y = event.clientY || window.innerHeight / 2;
      const endRadius = Math.hypot(
        Math.max(x, innerWidth - x),
        Math.max(y, innerHeight - y)
      );
      const transition = document.startViewTransition(() => applyTheme(name));
      transition.ready.then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 1000,
            easing: 'ease-out',
            pseudoElement: '::view-transition-new(root)',
          }
        );
      });
    })
  );
</script>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) {
    z-index: 1;
  }
  ::view-transition-new(root) {
    z-index: 9999;
  }
</style>
