---
interface Props {
  id?: string;
  className?: string;
  title?: string;
  subtitle?: string;
}

const { id, className, title, subtitle } = Astro.props;
---

<section id={id} class:list={['flex flex-col gap-4', className]}>
  {title && <h2 class="relative flex w-full items-center text-3xl">{title}</h2>}
  {subtitle && <p class="mb-4 px-1 text-lg text-skin-hue">{subtitle}</p>}
  <slot />
</section>
