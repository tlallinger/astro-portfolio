---
import '@/styles/globals.css';
import { getCV, lang, changeLanguage } from '@/i18n/utils';
import { languages, defaultLang } from '@/i18n/ui';
import FloatingBackButton from '@/components/FloatingBackButton.astro';
import { themeCss, themeNames } from '@/styles/theme';
import ThemeSwitch from '@/components/ThemeSwitch.astro';

interface Props {
  lang?: string;
  /** Page-specific title; the name is appended automatically. */
  title?: string;
  description?: string;
  hasBackBtn?: boolean;
}

if (Astro.props.lang) changeLanguage(Astro.props.lang);

const {
  basics: { image, summary, theme, firstname, name, label },
} = getCV();
const fullName = `${firstname} ${name}`;
const stripHtml = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const title = Astro.props.title ? `${Astro.props.title} – ${fullName}` : `${fullName} – ${label}`;
const description = Astro.props.description ?? stripHtml(summary);
const hasBackBtn = Astro.props.hasBackBtn ?? false;

// Language-neutral path ("" for the start page, "/impressum", ...) for canonical and alternate links.
const localePath = Astro.url.pathname.replace(/^\/(de|en)(?=\/|$)/, '').replace(/\/$/, '');
const site = Astro.site ?? new URL('https://world-wide.dev');
const urlFor = (code: string) => new URL(`/${code}${localePath}`, site).href;
const canonical = urlFor(lang);
const xDefault = localePath === '' ? site.href : urlFor(defaultLang);
const ogImage = new URL(image, site).href;
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={themeCss()} />
    <script is:inline define:vars={{ themeNames }}>
      // Runs before first paint so the stored theme never flashes.
      try {
        const stored = localStorage.getItem('theme');
        if (themeNames.includes(stored)) document.documentElement.dataset.theme = stored;
      } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {Object.keys(languages).map((code) => <link rel="alternate" hreflang={code} href={urlFor(code)} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href={image} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="referrer" content="no-referrer" />
  </head>
  <body class="relative bg-skin-fill font-sans">
    {hasBackBtn && <FloatingBackButton />}
    <ThemeSwitch className="fixed right-6 top-6 z-50" />

    <div class="absolute top-0 -z-10 h-full w-full">
      <div
        class="absolute bottom-auto left-[20%] right-auto top-0 h-[200px] w-[200px] -translate-x-[30%] translate-y-[20%] rounded-full bg-white/5 blur-[80px] contrast-more:hidden"
      >
      </div>
    </div>
    <slot />
    <style is:global>
      html {
        color-scheme: dark;
      }
    </style>
    <style>
      body,
      figure {
        margin: 0;
        padding: 0;
      }

      a {
        text-decoration: none;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      h1,
      h2,
      h3,
      h4 {
        @apply font-sans text-skin-base;
        margin: 0;
      }

      p {
        @apply text-sm text-skin-muted;
        line-height: 1.5;
        text-wrap: pretty;
      }

      .dev * {
        @apply border border-red-500/50 bg-red-500/5;
      }

      ::-webkit-scrollbar {
        width: 2px;
      }
    </style>
  </body>
</html>
